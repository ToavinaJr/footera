generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Domain-specific tables keep each aggregate isolated while preserving the
// current API payload during the first migration from the sql.js prototype.
model UserRecord {
  id      String @id
  payload Json
  @@map("users")
}
model AuthCredentialRecord {
  id      String @id
  payload Json
  @@map("auth_credentials")
}
model AuthSessionRecord {
  id      String @id
  payload Json
  @@map("auth_sessions")
}
model RoleRequestRecord {
  id      String @id
  payload Json
  @@map("role_requests")
}
model AuthLoginAttemptRecord {
  id        String   @id
  attempts  Int      @default(0)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("auth_login_attempts")
}
model PlayerRecord {
  id      String @id
  payload Json
  @@map("players")
}
model TeamRecord {
  id      String @id
  payload Json
  @@map("teams")
}
model ClubRecord {
  id      String @id
  payload Json
  @@map("clubs")
}
model MatchRecord {
  id      String @id
  payload Json
  @@map("matches")
}
model TournamentRecord {
  id      String @id
  payload Json
  @@map("tournaments")
}
model PitchRecord {
  id      String @id
  payload Json
  @@map("pitches")
}
model BookingRecord {
  id      String @id
  payload Json
  @@map("bookings")
}
model BookingSlotClaimRecord {
  id        String @id
  pitchId   String
  dateKey   String
  time      String
  bookingId String @unique
  @@unique([pitchId, dateKey, time])
  @@map("booking_slot_claims")
}
model RecruitmentAdRecord {
  id      String @id
  payload Json
  @@map("recruitment_ads")
}
model ApplicationRecord {
  id      String @id
  payload Json
  @@map("applications")
}
model MarketplaceRecord {
  id      String @id
  payload Json
  @@map("marketplace")
}
model NotificationRecord {
  id      String @id
  payload Json
  @@map("notifications")
}
model TeamInvitationRecord {
  id      String @id
  payload Json
  @@map("team_invitations")
}
model TeamJoinRequestRecord {
  id      String @id
  payload Json
  @@map("team_join_requests")
}
model LeagueStandingRecord {
  id      String @id
  payload Json
  @@map("league_standings")
}
model ActivityFeedRecord {
  id      String @id
  payload Json
  @@map("activity_feed")
}
model CatalogRecord {
  id      String @id
  payload Json
  @@map("catalogs")
}
model UploadedImageRecord {
  id        String   @id
  mimeType  String
  content   Bytes
  createdAt DateTime @default(now())
  @@map("uploaded_images")
}
