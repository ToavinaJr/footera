PORT=3000
# Set to the exact number of trusted reverse proxies in front of Express (0 locally).
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: set once before seeding if you need to sign in as the demo account.
SEED_USER_PASSWORD=
# On Vercel, set FRONTEND_URL=https://footera-frontend.vercel.app
FRONTEND_URL=http://localhost:3001
UPLOAD_DIR=uploads
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/footera?schema=public"
